#!/bin/sh
# Run the project's Agent Reach environment without changing global PATH.
set -eu
project_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
runtime_bin="$project_root/.venv/agent-reach/bin"
if [ ! -x "$runtime_bin/agent-reach" ]; then
    printf '%s\n' 'Agent Reach 项目环境不存在；请按项目 README 的步骤安装。' >&2
    exit 127
fi
PATH="$runtime_bin:$PATH"
export PATH
exec "$runtime_bin/agent-reach" "$@"
